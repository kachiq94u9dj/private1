// Cloudflare Workers の設定（OpenNext で Next.js を Workers 上で動かす）。
// デプロイ: npm run deploy、手元で Workers として確認: npm run preview
// wrangler deploy は OpenNext のプロジェクトを検出すると opennextjs-cloudflare deploy に処理を渡すため、
// 先に `npx opennextjs-cloudflare build` が必要（Workers Builds の Build command にもこれを設定する）。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tomodachi-note",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "tomodachi-note"
    }
  ],
  "observability": {
    "enabled": true
  }
}
